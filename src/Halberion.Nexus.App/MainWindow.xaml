<Window x:Class="Halberion.Nexus.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HALBERION NEXUS" Width="1420" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
 <Grid x:Name="RootGrid" Background="{StaticResource PageBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="22,26"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="HALBERION" FontSize="23" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="NEXUS" FontSize="31" FontWeight="Light" Foreground="{StaticResource SilverBrush}" Margin="0,1,0,0"/><TextBlock Text="Unified System Control" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,22"/><Button Content="Anasayfa" Tag="dashboard" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,13"/><Button Content="Hotspot Control" Tag="hotspot" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Button Content="System Control" Tag="system" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Button Content="Network Monitor" Tag="network" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Button Content="Device Control" Tag="device" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Button Content="Storage Manager" Tag="storage" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="Ayarlar" Tag="settings" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Button Content="Kayıtlar" Tag="logs" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Button Content="Hakkında" Tag="about" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}"/><Border Background="{StaticResource AccentDimBrush}" CornerRadius="10" Padding="11" Margin="0,9,0,12"><TextBlock Text="Gerçek veriler • Açık onay • Geri alınabilir işlemler" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Border><TextBlock Text="Azat Berkan Ölçer • Halberion Studio" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="v0.2.5 • Windows x64" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="26,18,26,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageHeading" Text="Halberion Nexus" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Azat Berkan Ölçer · Halberion Studio" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Dil" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LanguageBox" Width="132" SelectionChanged="Language_Changed"><ComboBoxItem Content="Sistem dili" Tag="auto"/><ComboBoxItem Content="Türkçe" Tag="tr"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></StackPanel></Grid><Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22"><ContentControl x:Name="ContentHost"/></Border><TextBlock x:Name="FooterText" Grid.Row="2" Text="Hazır • Yönetici yetkisi yalnız açıkça onaylanan işlemde istenir" Foreground="{StaticResource MutedBrush}" Margin="3,12,0,0" FontSize="11"/></Grid>
  <Border x:Name="WelcomeOverlay" Grid.ColumnSpan="2" Background="#F507101C" Opacity="0" Visibility="Collapsed" Panel.ZIndex="10"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="WelcomeText" Text="Nexus, Halberion'a hoş geldin" Foreground="{StaticResource TextBrush}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/><Button x:Name="WelcomeContinueButton" Content="Devam et" Click="ContinueWelcome_Click" IsDefault="True" HorizontalAlignment="Center" MinWidth="150"/></StackPanel></Border>
 </Grid>
</Window>
