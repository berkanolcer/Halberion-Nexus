<UserControl x:Class="Halberion.Nexus.Modules.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}"><StackPanel Margin="0,0,10,4">
 <Border Background="#102945" BorderBrush="#28527A" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Nexus, Halberion'a hoş geldin" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Sisteminin gerçek zamanlı görünümü ve araçlarına hızlı erişim." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/><TextBlock x:Name="UpdatedText" Text="Ölçümler hazırlanıyor…" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0" FontSize="12"/></StackPanel><Border Grid.Column="1" Background="#0B1A2B" CornerRadius="12" Padding="16" VerticalAlignment="Center"><StackPanel><TextBlock Text="HALBERION NEXUS" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><TextBlock Text="Azat Berkan Ölçer · Halberion Studio" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></Grid></Border>
 <UniformGrid Columns="3" Margin="0,0,0,4"><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="CpuText" Text="—" FontSize="30"/><ProgressBar x:Name="CpuBar" Maximum="100"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="RAM" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="RamText" Text="—" FontSize="30"/><ProgressBar x:Name="RamBar" Maximum="100"/><TextBlock x:Name="RamDetailText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="GPU YÜKÜ" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="GpuText" Text="—" FontSize="30"/><ProgressBar x:Name="GpuBar" Maximum="100"/><TextBlock x:Name="GpuDetailText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="DİSK" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="DiskText" Text="—" FontSize="26"/><TextBlock x:Name="DiskDetailText" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="AĞ" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="NetworkText" Text="—" FontSize="22" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="NetworkDetailText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="AYGITLAR / UYARILAR" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="DeviceText" Text="—" FontSize="24"/><TextBlock x:Name="AlertText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
 <TextBlock Text="Hızlı erişim" FontSize="19" FontWeight="SemiBold" Margin="2,9,0,10"/><UniformGrid Columns="2" Margin="0,0,0,4"><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="System Control" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Sistem kaynaklarını, grafik işlemcisini ve donanım sensörlerini canlı izleyin." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/><Button Content="Performansa git" Tag="system" Click="QuickNavigate_Click" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Network Monitor" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Uygulama internetini ve bağlantı geçmişini inceleyin; erişim kurallarını siz yönetin." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/><Button Content="Ağ etkinliğini incele" Tag="network" Click="QuickNavigate_Click" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Device Control" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Aygıtların ne işe yaradığını öğrenin; Bluetooth aksesuarlarınızın bağlantı durumunu görün." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/><Button Content="Aygıtları gör" Tag="device" Click="QuickNavigate_Click" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="Storage Manager" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Disk alanını bulun, klasörleri analiz edin ve güvenli temizlik adaylarını inceleyin." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/><Button Content="Depolamayı incele" Tag="storage" Click="QuickNavigate_Click" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid>
 <TextBlock Text="Durum" FontSize="19" FontWeight="SemiBold" Margin="2,18,0,10"/><Border Style="{DynamicResource CardStyle}"><TextBlock x:Name="SummaryText" Text="Hazırlanıyor…" TextWrapping="Wrap" LineHeight="24"/></Border>
 </StackPanel></ScrollViewer></UserControl>
