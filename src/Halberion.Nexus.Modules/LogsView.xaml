<UserControl x:Class="Halberion.Nexus.Modules.LogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,16"><TextBlock Text="Logs" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Parola ve gizli bilgiler kayda yazılmaz. Kayıtlar bu oturumda yerel bellekte tutulur." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><DataGrid x:Name="LogGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Width="100"/><DataGridTextColumn Header="Modül" Binding="{Binding Module}" Width="130"/><DataGridTextColumn Header="Düzey" Binding="{Binding Level}" Width="90"/><DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></Grid></UserControl>
