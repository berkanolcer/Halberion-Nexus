<UserControl x:Class="Halberion.Nexus.Modules.NetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Network Monitor" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="AdapterText" Text="Adaptör ve uygulama bağlantıları okunuyor…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="Refresh_Click"/></Grid>
 <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center"><TextBlock Text="İzlenen bağdaştırıcı" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/><ComboBox x:Name="AdapterBox" Width="470" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="Adapter_Changed"/><TextBlock x:Name="TrafficNoteText" Text="Canlı hız ilk ölçüm aralığından sonra görünür." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
 <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14"><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="İNDİRME" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="DownText" Text="—" FontSize="28" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="YÜKLEME" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="UpText" Text="—" FontSize="28"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,10,0"><StackPanel><TextBlock Text="UYGULAMA BAĞLANTISI" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ConnectionCountText" Text="—" FontSize="28"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="YENİ UYARI" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="AlertCountText" Text="0" FontSize="28" Foreground="{DynamicResource WarningBrush}"/></StackPanel></Border></UniformGrid>
 <TabControl Grid.Row="3"><TabItem Header="Uygulamalar ve bağlantılar"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="8"><TextBlock Text="Uygulama bağlantıları anlık Windows tablosudur. Hızlar seçili ağ bağdaştırıcısı toplamıdır; Windows burada uygulama başına bayt sayacı sunmuyor." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Bottom" Margin="0,8,0,0"/><WrapPanel><TextBox x:Name="SearchBox" Width="260" TextChanged="Search_Changed" ToolTip="Uygulama, adres veya PID ara"/><Button Content="Seçili uygulamayı engelle" Click="Block_Click" Margin="8,0,0,0"/><Button x:Name="UndoButton" Content="Son engeli geri al" Click="Undo_Click" Margin="8,0,0,0" IsEnabled="False"/></WrapPanel></DockPanel><DataGrid x:Name="ConnectionsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Uygulama" Binding="{Binding ProcessName}" Width="155"/><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/><DataGridTextColumn Header="Tür" Binding="{Binding Protocol}" Width="60"/><DataGridTextColumn Header="Yerel" Binding="{Binding Local}" Width="170"/><DataGridTextColumn Header="Uzak" Binding="{Binding Remote}" Width="170"/><DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="90"/><DataGridTextColumn Header="Yol" Binding="{Binding ProcessPath}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Trafik geçmişi"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="155"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Margin="8" Foreground="{DynamicResource MutedBrush}" Text="Yerel toplamlar seçili bağdaştırıcı için 10 saniyede bir kaydedilir ve 30 gün tutulur; uzak adres geçmişe yazılmaz."/><Border Grid.Row="1" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="8,0,8,10" Padding="8"><Canvas x:Name="TrafficChart" SizeChanged="TrafficChart_SizeChanged"><Polyline x:Name="DownloadLine" Stroke="#59E3C5" StrokeThickness="2"/><Polyline x:Name="UploadLine" Stroke="#88A5FF" StrokeThickness="2"/></Canvas></Border><DataGrid x:Name="HistoryGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Zaman" Binding="{Binding TimeText}" Width="170"/><DataGridTextColumn Header="Adaptör" Binding="{Binding Adapter}" Width="*"/><DataGridTextColumn Header="İndirme Mbit/s" Binding="{Binding DownloadMbit}" Width="140"/><DataGridTextColumn Header="Yükleme Mbit/s" Binding="{Binding UploadMbit}" Width="140"/><DataGridTextColumn Header="Bağlantı" Binding="{Binding ActiveConnections}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Gecikme testi"><StackPanel Margin="14"><TextBlock Text="IP adresine dört ölçümlü gecikme testi" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Arka planda ping gönderilmez. Yerel ağ geçidinizi veya denemek istediğiniz IP adresini girin." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/><WrapPanel><TextBox x:Name="PingTargetBox" Width="220" ToolTip="Örn. 192.168.1.1"/><Button x:Name="PingButton" Content="4 ping gönder" Click="Ping_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="PingSummaryText" Text="Hedef IP girin; ICMP yanıtı hedef ağ tarafından engellenebilir." Margin="0,14,0,10"/><ItemsControl x:Name="PingResultsList"/></StackPanel></TabItem><TabItem Header="Yeni bağlantı uyarıları"><DataGrid x:Name="AlertsGrid"><DataGrid.Columns><DataGridTextColumn Header="Uygulama" Binding="{Binding ProcessName}" Width="180"/><DataGridTextColumn Header="Uzak" Binding="{Binding Remote}" Width="220"/><DataGridTextColumn Header="Tür" Binding="{Binding Protocol}" Width="90"/><DataGridTextColumn Header="Yol" Binding="{Binding ProcessPath}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Kapsam ve gizlilik"><Border Style="{DynamicResource CardStyle}" Margin="8"><TextBlock Text="Uygulama/PID bağlantıları yerel Windows IP Helper tablolarından okunur. Uzak adresler üçüncü tarafa gönderilmez ve trafik geçmişine yazılmaz. Ayrı paket yakalama sürücüsü kurulmaz. Güvenlik duvarı değişikliği yalnız seçili uygulama için açık onay ve Windows UAC sonrasında, Halberion Nexus adlı ayrı bir kural olarak yapılır; geri alma kaydı uygulama yeniden başlatılsa da korunur. PdaNet veya ağ adaptörü ayarları değiştirilmez." TextWrapping="Wrap" LineHeight="25"/></Border></TabItem></TabControl>
</Grid></UserControl>
