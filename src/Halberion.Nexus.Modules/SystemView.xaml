<UserControl x:Class="Halberion.Nexus.Modules.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="System Control" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="UpdatedText" Text="Gerçek sistem ölçümleri hazırlanıyor…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="Refresh_Click"/></Grid>
 <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14"><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="CpuText" Text="—" FontSize="28"/><ProgressBar x:Name="CpuBar" Maximum="100"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="RAM" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="RamText" Text="—" FontSize="28"/><ProgressBar x:Name="RamBar" Maximum="100"/><TextBlock x:Name="RamDetailText" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="GPU YÜKÜ" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="GpuText" Text="—" FontSize="28"/><ProgressBar x:Name="GpuBar" Maximum="100"/><TextBlock x:Name="GpuDetailText" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU / GPU SICAKLIĞI" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="TemperatureText" Text="—" FontSize="22"/><TextBlock x:Name="FanText" Text="Fan —" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="ÇALIŞMA SÜRESİ" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="UptimeText" Text="—" FontSize="22"/><TextBlock x:Name="SensorCapabilityText" Text="Sensör yeteneği denetleniyor" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
 <TabControl Grid.Row="2"><TabItem Header="Performans"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Oyun kare hızı" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FpsStatusText" Text="FPS — oyun çalışırken ölçüm başlatın" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/><WrapPanel><TextBox x:Name="PresentMonPathBox" Width="430" ToolTip="PresentMon-*.exe yolu"/><Button Content="Araca göz at" Click="BrowsePresentMon_Click" Margin="7,0,0,0"/><Button x:Name="FpsButton" Content="FPS ölçümünü başlat" Click="Fps_Click" Margin="7,0,0,0"/><Button Content="PresentMon indir" Click="PresentMonLink_Click" Margin="7,0,0,0"/></WrapPanel></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentDimBrush}" CornerRadius="12" Padding="16" VerticalAlignment="Top"><StackPanel><TextBlock Text="FPS" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="FpsHeadlineText" Text="—" Foreground="{DynamicResource AccentBrush}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border></Grid></Border><TextBlock Grid.Row="1" x:Name="PerformanceSummaryText" Text="CPU, grafik işlemcisi, sıcaklık, fan, frekans, güç ve bellek değerleri yalnız gerçek donanım sensörleri sunuyorsa gösterilir." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,0,9"/><DataGrid x:Name="FpsGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Oyun / uygulama" Binding="{Binding Application}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80"/><DataGridTextColumn Header="FPS" Binding="{Binding FpsText}" Width="90"/><DataGridTextColumn Header="Kare süresi" Binding="{Binding FrameTimeText}" Width="115"/><DataGridTextColumn Header="GPU meşgul" Binding="{Binding GpuText}" Width="115"/><DataGridTextColumn Header="CPU meşgul" Binding="{Binding CpuText}" Width="115"/></DataGrid.Columns></DataGrid></Grid></TabItem>
 <TabItem Header="Sensörler"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="6"><TextBlock x:Name="SensorStatusText" Text="Donanım sensörleri taranıyor…" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><ComboBox x:Name="SensorFilterBox" Width="170" DockPanel.Dock="Right" SelectionChanged="SensorFilter_Changed"><ComboBoxItem Content="Tümü" Tag="all"/><ComboBoxItem Content="CPU" Tag="cpu"/><ComboBoxItem Content="GPU" Tag="gpu"/><ComboBoxItem Content="Sıcaklık" Tag="Temperature"/><ComboBoxItem Content="Fan" Tag="Fan"/><ComboBoxItem Content="Yük" Tag="Load"/><ComboBoxItem Content="Saat hızı" Tag="Clock"/><ComboBoxItem Content="Güç" Tag="Power"/><ComboBoxItem Content="Bellek" Tag="memory"/></ComboBox></DockPanel><DataGrid x:Name="SensorGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Donanım" Binding="{Binding Hardware}" Width="220"/><DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="Sensör" Binding="{Binding Sensor}" Width="*"/><DataGridTextColumn Header="Anlık" Binding="{Binding CurrentText}" Width="110"/><DataGridTextColumn Header="Min" Binding="{Binding MinimumText}" Width="110"/><DataGridTextColumn Header="Maks" Binding="{Binding MaximumText}" Width="110"/></DataGrid.Columns></DataGrid></Grid></TabItem>
 <TabItem Header="İşlemler"><DataGrid x:Name="ProcessGrid"><DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="85"/><DataGridTextColumn Header="İşlem" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="CPU" Binding="{Binding CpuUsagePercent, StringFormat={}{0:F1}%}" Width="110"/><DataGridTextColumn Header="RAM" Binding="{Binding WorkingSetBytes, Converter={StaticResource ByteSizeConverter}}" Width="130"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Başlangıç"><DataGrid x:Name="StartupGrid"><DataGrid.Columns><DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Kapsam" Binding="{Binding Scope}" Width="140"/><DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="180"/><DataGridTextColumn Header="Komut" Binding="{Binding Command}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Donanım"><ScrollViewer><Border Style="{DynamicResource CardStyle}" Margin="8"><StackPanel><TextBlock x:Name="HardwareText" Text="Hazırlanıyor…" FontSize="15" TextWrapping="Wrap" LineHeight="27"/><Border Background="{DynamicResource AccentDimBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock Text="HWiNFO benzeri geniş sensör envanteri, LibreHardwareMonitor tarafından donanımın gerçekten sunduğu ölçümlerle sağlanır. Anakart, BIOS, sürücü ve yetki sınırları nedeniyle bazı değerler eksik olabilir. Nexus fan eğrisi, voltaj veya saat hızını değiştirmez; FPS/RAM kazanımı vaat etmez." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel></Border></ScrollViewer></TabItem></TabControl>
</Grid></UserControl>
