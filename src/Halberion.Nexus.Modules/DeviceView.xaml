<UserControl x:Class="Halberion.Nexus.Modules.DeviceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Device Control" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Bluetooth aksesuarları ve Windows aygıtları okunuyor…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="Refresh_Click"/></Grid>
 <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14"><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="BLUETOOTH AKSESUAR" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="BluetoothText" Text="—" FontSize="27"/><TextBlock Text="Fare, klavye, kulaklık ve benzeri" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="USB AYGITLARI" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="UsbText" Text="—" FontSize="27"/><TextBlock Text="Bağlı USB birimleri" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="SES UÇLARI" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="AudioText" Text="—" FontSize="27"/><TextBlock Text="Giriş ve çıkış aygıtları" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="GÜÇ PLANI" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="PowerText" Text="—" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="Windows'un etkin planı" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></Border></UniformGrid>
 <TabControl Grid.Row="2"><TabItem Header="Bluetooth aksesuarları"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.ColumnSpan="3" Margin="6,5,6,12"><StackPanel><TextBlock Text="Fare, klavye, kulaklık ve diğer Bluetooth aksesuarları" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Aygıt listesi Windows'un şu anda algıladığı aygıtlardan oluşur. Eşleştirme ve bağlanma Windows Bluetooth ayarlarından yapılır." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><Button Content="Bluetooth ayarlarını aç" Tag="ms-settings:bluetooth" Click="Open_Click" DockPanel.Dock="Right" Margin="14,0,0,0"/></DockPanel><DataGrid x:Name="BluetoothGrid" Grid.Row="1" SelectionChanged="Bluetooth_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Aygıt" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Tür" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="Windows durumu" Binding="{Binding State}" Width="145"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0"><StackPanel><TextBlock Text="Aygıt hakkında" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="BluetoothNameText" Text="Listeden bir Bluetooth aygıtı seçin" FontSize="16" TextWrapping="Wrap" Margin="0,13,0,7"/><TextBlock x:Name="BluetoothDescriptionText" Text="Seçili aygıtın ne işe yaradığını burada açıklayacağız." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="22"/><TextBlock x:Name="BluetoothStatusDetailText" Text="Bağlantı durumu burada gösterilir." TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border></Grid></TabItem>
 <TabItem Header="Aygıt yöneticisi"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Tüm görünen donanım" FontSize="17" FontWeight="SemiBold" Margin="8,5,0,2"/><TextBlock Text="Bu teknik envanter ayrıntılı aygıt listesidir. Günlük kullanımda Bluetooth aksesuarları sekmesini kullanabilirsiniz." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="8,2,8,8"/></StackPanel><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="6"><TextBox x:Name="SearchBox" Width="255" TextChanged="Filter_Changed" ToolTip="Aygıt adı ara"/><ComboBox x:Name="CategoryBox" Width="155" Margin="8,0,0,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Tümü"/><ComboBoxItem Content="Bluetooth"/><ComboBoxItem Content="USB"/><ComboBoxItem Content="Ses"/><ComboBoxItem Content="Ekran"/><ComboBoxItem Content="Ağ"/><ComboBoxItem Content="Giriş"/><ComboBoxItem Content="Diğer"/></ComboBox><Button Content="Windows Aygıt Yöneticisi" Tag="devmgmt.msc" Click="Open_Click" Margin="8,0,0,0"/></WrapPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid x:Name="DevicesGrid" SelectionChanged="Device_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Aygıt" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Tür" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="Üretici" Binding="{Binding Manufacturer}" Width="145"/><DataGridTextColumn Header="Durum" Binding="{Binding UserStatus}" Width="130"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="Ne işe yarıyor?" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DeviceDescriptionText" Text="Listeden bir aygıt seçin." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,14"/><TextBlock Text="Windows durumu" FontWeight="SemiBold"/><TextBlock x:Name="DeviceStatusDetailText" Text="—" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/><TextBlock x:Name="DeviceProblemText" Text="" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0"/></StackPanel></Border></Grid></Grid></Grid></TabItem>
 <TabItem Header="Ses"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Windows ses ayarları" Tag="ms-settings:sound" Click="Open_Click" HorizontalAlignment="Left" Margin="8"/><DataGrid x:Name="AudioGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Uç" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Yön" Binding="{Binding Direction}" Width="100"/><DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="110"/><DataGridCheckBoxColumn Header="Varsayılan" Binding="{Binding IsDefault}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Ekran ve güç"><ScrollViewer><StackPanel Margin="8"><WrapPanel><Button Content="Ekran ayarları" Tag="ms-settings:display" Click="Open_Click" Margin="0,0,8,8"/><Button Content="Güç ayarları" Tag="ms-settings:powersleep" Click="Open_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="PowerDetailText" TextWrapping="Wrap" LineHeight="24" Margin="0,8,0,12"/><DataGrid x:Name="DisplayGrid" Height="250"><DataGrid.Columns><DataGridTextColumn Header="Ekran" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Genişlik" Binding="{Binding Width}" Width="90"/><DataGridTextColumn Header="Yükseklik" Binding="{Binding Height}" Width="90"/><DataGridTextColumn Header="Hz" Binding="{Binding RefreshRate}" Width="70"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></TabItem></TabControl>
</Grid></UserControl>
