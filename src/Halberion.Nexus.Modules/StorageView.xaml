<UserControl x:Class="Halberion.Nexus.Modules.StorageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Storage Manager" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Disk envanteri okunuyor…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Diskleri yenile" Click="RefreshDrives_Click"/></Grid>
 <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12"><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="KULLANILAN ALAN" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="UsedTotalText" Text="—" FontSize="25"/><TextBlock x:Name="UsedDriveCountText" Text="Sürücü toplamı" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="BOŞ ALAN" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="FreeTotalText" Text="—" FontSize="25"/><TextBlock Text="Hazır yerel sürücüler" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border><Border Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="DİSK SAĞLIĞI" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="HealthSummaryText" Text="Okunuyor…" FontSize="17" TextWrapping="Wrap"/><TextBlock Text="Windows sağlayıcısı desteklediği kadarını bildirir" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
 <TabControl Grid.Row="2"><TabItem Header="Diskler"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="DrivesGrid"><DataGrid.Columns><DataGridTextColumn Header="Sürücü" Binding="{Binding Name}" Width="85"/><DataGridTextColumn Header="Etiket" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="110"/><DataGridTextColumn Header="Biçim" Binding="{Binding Format}" Width="90"/><DataGridTextColumn Header="Kullanılan" Binding="{Binding UsedBytes, Converter={StaticResource ByteSizeConverter}}" Width="125"/><DataGridTextColumn Header="Boş" Binding="{Binding FreeBytes, Converter={StaticResource ByteSizeConverter}}" Width="125"/><DataGridTextColumn Header="Doluluk" Binding="{Binding UsedPercent, StringFormat={}{0:F1}%}" Width="90"/><DataGridTemplateColumn Header="Kullanım" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,10,0,0"><StackPanel><TextBlock Text="Fiziksel disk sağlık bilgisi" FontWeight="SemiBold"/><TextBlock x:Name="HealthText" Text="Windows depolama sağlayıcısı okunuyor…" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border></Grid></TabItem>
 <TabItem Header="Klasör analizi"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="6"><Button Content="Klasör seç" Click="Pick_Click"/><Button x:Name="ScanButton" Content="Analiz et" Click="Scan_Click" Margin="8,0,0,0" IsEnabled="False"/><Button x:Name="CancelButton" Content="İptal" Click="Cancel_Click" Margin="8,0,0,0" IsEnabled="False"/><Button Content="Dosya konumunu aç" Click="OpenLargest_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="FolderText" Grid.Row="1" Text="Klasör seçilmedi" Foreground="{DynamicResource MutedBrush}" Margin="8,0,8,10" TextTrimming="CharacterEllipsis"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><DataGrid x:Name="FolderGrid"><DataGrid.Columns><DataGridTextColumn Header="Üst klasör" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Dosya" Binding="{Binding FileCount}" Width="90"/><DataGridTextColumn Header="Boyut" Binding="{Binding Bytes, Converter={StaticResource ByteSizeConverter}}" Width="120"/></DataGrid.Columns></DataGrid><DataGrid x:Name="LargestGrid" Grid.Column="2"><DataGrid.Columns><DataGridTextColumn Header="Büyük dosya" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Konum" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Boyut" Binding="{Binding Bytes, Converter={StaticResource ByteSizeConverter}}" Width="120"/></DataGrid.Columns></DataGrid></Grid><TextBlock x:Name="ScanSummaryText" Grid.Row="3" Text="Seçtiğiniz klasörde dosya boyutları salt-okunur incelenir." Foreground="{DynamicResource MutedBrush}" Margin="8,9,8,0" TextWrapping="Wrap"/></Grid></TabItem>
 <TabItem Header="Yinelenen dosyalar"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="6"><Button x:Name="DuplicateScanButton" Content="Seçili klasörde yinelenen dosyaları bul" Click="Duplicates_Click" IsEnabled="False"/><Button x:Name="DuplicateCancelButton" Content="İptal" Click="DuplicateCancel_Click" IsEnabled="False" Margin="8,0,0,0"/><Button Content="Seçili dosyanın konumunu aç" Click="OpenDuplicate_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="DuplicateSummaryText" Grid.Row="1" Text="Aynı boyuttaki dosyalar SHA-256 ile doğrulanır. Hiçbir dosya silinmez." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="8,0,8,8"/><DataGrid x:Name="DuplicateGrid" Grid.Row="2" SelectionChanged="Duplicate_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Dosya grubu" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Kopya" Binding="{Binding Copies}" Width="75"/><DataGridTextColumn Header="Dosya boyutu" Binding="{Binding SizeText}" Width="130"/><DataGridTextColumn Header="Olası yinelenen veri" Binding="{Binding RepeatedDataText}" Width="160"/><DataGridTextColumn Header="SHA-256" Binding="{Binding ShortHash}" Width="130"/></DataGrid.Columns></DataGrid></Grid></TabItem>
 <TabItem Header="Güvenli temizlik"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource CardStyle}" Margin="6"><TextBlock Text="Yalnız Windows geçici klasöründe, ayarladığınız yaştan eski dosyalar incelenir. Seçilen tek dosya için ayrıca onay alınır ve Geri Dönüşüm Kutusu'na gönderilir. Kullanıcı belgeleri, klasörler, yeniden ayrıştırma noktaları ve Unity önbelleği otomatik silinmez." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border><WrapPanel Grid.Row="1" Margin="6,0,6,8"><Button x:Name="TempScanButton" Content="Geçici adayları tara" Click="TempScan_Click"/><Button Content="Seçili dosyayı Geri Dönüşüm Kutusu'na gönder" Click="Recycle_Click" Margin="8,0,0,0"/></WrapPanel><DataGrid x:Name="TempGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Dosya" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Konum" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Boyut" Binding="{Binding Bytes, Converter={StaticResource ByteSizeConverter}}" Width="120"/><DataGridTextColumn Header="Yaş" Binding="{Binding AgeDays, StringFormat={}{0} gün}" Width="90"/></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl>
</Grid></UserControl>
