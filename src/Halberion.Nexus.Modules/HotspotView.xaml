<UserControl x:Class="Halberion.Nexus.Modules.HotspotView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource PageBrush}"><StackPanel Margin="0,0,12,0">
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hotspot Control" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="SourceText" Text="PdaNet ve Windows tethering API hazırlanıyor…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Yenile" Click="Refresh_Click"/></Grid>
  <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Windows API durumu" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ApiText" Text="Hazırlanıyor…" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel></Border>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="Wi-Fi yapılandırması" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="SSID" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="SsidBox" Margin="0,5,0,10"/><TextBlock Text="Parola (en az 8 karakter)" Foreground="{DynamicResource MutedBrush}"/><PasswordBox x:Name="PasswordBox" Margin="0,5,0,10"/><TextBlock Text="Bant" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="BandBox" Margin="0,5,0,14"><ComboBoxItem Content="Otomatik" Tag="Auto"/><ComboBoxItem Content="2.4 GHz" Tag="TwoPointFour"/><ComboBoxItem Content="5 GHz" Tag="Five"/></ComboBox><WrapPanel><Button Content="Ayarları uygula" Click="Apply_Click" Margin="0,0,8,8"/><Button Content="QR oluştur" Click="Qr_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border>
   <Border Grid.Column="2" Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="Canlı durum" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StateText" Text="Bilinmiyor" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,12"/><WrapPanel><Button x:Name="StartButton" Content="Hotspot'u başlat" Click="Start_Click" Margin="0,0,8,8"/><Button x:Name="StopButton" Content="Durdur" Click="Stop_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="ClientCountText" Text="Bağlı cihaz: 0" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6"/><DataGrid x:Name="ClientsGrid" Height="150"><DataGrid.Columns><DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="150"/><DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150"/></DataGrid.Columns></DataGrid></StackPanel></Border>
  </Grid>
  <Border Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="Tanı ve işlem kaydı" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="DiagnosticBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="180" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
