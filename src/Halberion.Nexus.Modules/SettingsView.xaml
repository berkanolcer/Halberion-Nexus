<UserControl x:Class="Halberion.Nexus.Modules.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer Background="{DynamicResource SurfaceBrush}"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Ayarlar" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Ayarlar yerel kullanıcı profilinde saklanır; parola veya gizli bilgi içermez." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/><Border Style="{DynamicResource CardStyle}"><StackPanel><TextBlock Text="Dil" FontWeight="SemiBold"/><TextBlock Text="İlk açılışta Windows dili kullanılır; buradan Türkçe veya İngilizce seçebilirsiniz." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,7"/><ComboBox x:Name="LanguageBox" Width="180" HorizontalAlignment="Left" Margin="0,4,0,18"><ComboBoxItem Content="Sistem dili" Tag="auto"/><ComboBoxItem Content="Türkçe" Tag="tr"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><TextBlock Text="Canlı yenileme aralığı" FontWeight="SemiBold"/><ComboBox x:Name="RefreshBox" Width="180" HorizontalAlignment="Left" Margin="0,7,0,16"><ComboBoxItem Content="1 saniye" Tag="1"/><ComboBoxItem Content="2 saniye" Tag="2"/><ComboBoxItem Content="5 saniye" Tag="5"/><ComboBoxItem Content="10 saniye" Tag="10"/></ComboBox><CheckBox x:Name="AlertsCheck" Content="Yeni ağ bağlantısı uyarılarını etkinleştir" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/><TextBlock Text="Geçici dosya aday yaşı" FontWeight="SemiBold"/><ComboBox x:Name="TempAgeBox" Width="180" HorizontalAlignment="Left" Margin="0,7,0,18"><ComboBoxItem Content="3 gün" Tag="3"/><ComboBoxItem Content="7 gün" Tag="7"/><ComboBoxItem Content="14 gün" Tag="14"/><ComboBoxItem Content="30 gün" Tag="30"/></ComboBox><Button Content="Ayarları kaydet" Click="Save_Click" HorizontalAlignment="Left"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
